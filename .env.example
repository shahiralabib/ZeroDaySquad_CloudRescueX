ENVIRONMENT=local
PORT=8000
# Relative SQLite paths resolve against the directory the API/Alembic is started from (use backend/).
# Use a dedicated file for presentations, e.g. sqlite+aiosqlite:///./cloudrescue_demo.db
# Automated tests ignore this value and always use a temporary database.
DATABASE_URL=sqlite+aiosqlite:///./cloudrescue.db
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SEED_DEMO_DATA=true
MONITORING_ENABLED=true
MONITORING_DEFAULT_INTERVAL_SECONDS=30
# Authentication: required to sign in (without these the API answers 503 on login). Generate real values; never commit them.
#   python -m app.auth generate-secret                              -> AUTH_SECRET
#   python -m app.auth hash-password --username NAME --role ROLE    -> one entry of AUTH_USERS_JSON (roles: viewer, operator, admin)
# AUTH_USERS_JSON is a JSON array of {"username","role","password_hash"} objects; use single quotes around it in a .env file.
AUTH_SECRET=
AUTH_USERS_JSON=
AUTH_TOKEN_TTL_MINUTES=60
VITE_API_BASE_URL=http://localhost:8000
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=
AI_CONFIDENCE_THRESHOLD=0.65
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CLOUD_MONITORING_ENABLED=false
CLOUD_LOGGING_ENABLED=false
FIRESTORE_ENABLED=false
STORAGE_BACKEND=sqlite
FIRESTORE_DATABASE=(default)
REQUEST_MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
